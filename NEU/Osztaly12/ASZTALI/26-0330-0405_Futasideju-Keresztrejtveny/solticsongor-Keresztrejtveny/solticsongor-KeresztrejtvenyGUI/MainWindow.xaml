<Window x:Class="solticsongor_KeresztrejtvenyGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Keresztrejtveny készítő" Height="600" Width="800">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Sorok száma [sor x oszlop]:" VerticalAlignment="Center"/>
            <ComboBox x:Name="cbSorok" Width="50" Margin="5,0"/>
            <ComboBox x:Name="cbOszlopok" Width="50" Margin="5,0"/>
            
            <Button x:Name="btnLetrehoz" Content="Keresztrejtveny létrehozása" Margin="20,0,10,0" Click="btnLetrehoz_Click"/>
            
            <Label Content="Keresztrejtveny mentése:" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <ComboBox x:Name="cbIndex" Width="50" Margin="5,0"/>
            <Button x:Name="btnMent" Content="Mentés" Margin="10,0" Click="btnMent_Click"/>
        </StackPanel>
        
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <UniformGrid x:Name="ugRacs" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </ScrollViewer>
    </DockPanel>
</Window>
