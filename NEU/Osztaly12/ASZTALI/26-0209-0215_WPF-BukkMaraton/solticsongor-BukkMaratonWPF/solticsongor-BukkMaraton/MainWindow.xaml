<Window x:Class="solticsongor_BukkMaraton.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:solticsongor_BukkMaraton"
        mc:Ignorable="d"
        Title="Bükk Maraton 2019" Height="350" Width="400" Background="#F0F0F0">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Content="Táv:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox x:Name="TavComboBox" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="10,5" SelectedIndex="3">
            <ComboBoxItem Content="Mini - 16km" Tag="16"/>
            <ComboBoxItem Content="Rövid - 38km" Tag="38"/>
            <ComboBoxItem Content="Pedelec - 54km" Tag="54"/>
            <ComboBoxItem Content="Közép - 57km" Tag="57"/>
            <ComboBoxItem Content="Hosszú - 94km" Tag="94"/>
        </ComboBox>

        <Button x:Name="SzamolButton" Content="Számol" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Width="80" Height="60" Margin="10,5" Click="SzamolButton_Click"/>

        <Label Content="Idő [óra:perc:mp]:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="IdoTextBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="10,5" Text="1:00:00"/>

        <Label Content="Átlagsebesség [km/h]:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,15,0,5"/>
        <TextBlock x:Name="SebessegKmhTextBlock" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="10,15,10,5" Background="White" Padding="5"/>

        <Label Content="Átlagsebesség [m/s]:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <TextBlock x:Name="SebessegMsTextBlock" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="10,5" Background="White" Padding="5"/>

    </Grid>
</Window>
