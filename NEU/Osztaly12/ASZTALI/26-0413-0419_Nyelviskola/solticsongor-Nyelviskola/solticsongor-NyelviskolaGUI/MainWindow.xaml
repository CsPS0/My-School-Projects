<Window x:Class="solticsongor_NyelviskolaGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nyelvtanárok adatai" Height="450" Width="400">
    <StackPanel Margin="10">
        <TextBlock Text="Kérem válasszon nyelvet:"/>
        <ComboBox x:Name="cbNyelv" SelectionChanged="CbNyelv_OnSelectionChanged" DisplayMemberPath="NyelvNev" Margin="0,5,0,15"/>
        
        <TextBlock Text="Kérem válasszon tanárt:"/>
        <ComboBox x:Name="cbTanar" SelectionChanged="CbTanar_OnSelectionChanged" DisplayMemberPath="Nev" Margin="0,5,0,15" IsEnabled="False"/>
        
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="Telefon:" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox x:Name="tbTelefon" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,10"/>
            
            <TextBlock Text="Email:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox x:Name="tbEmail" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,10"/>
            
            <TextBlock Text="Óradíj:" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                <TextBox x:Name="tbOradij" Width="100" IsReadOnly="True"/>
                <TextBlock Text="Ft" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
            
            <TextBlock Text="Online óra:" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <CheckBox x:Name="cbOnline" Grid.Row="3" Grid.Column="1" IsEnabled="False" VerticalAlignment="Center" Margin="0,0,0,10"/>
        </Grid>
    </StackPanel>
</Window>
