<Window x:Class="solticsongor_Toto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:solticsongor_Toto"
        mc:Ignorable="d"
        Title="Totó eredmény ellenőrző" Height="300" Width="400">
    <StackPanel Margin="10">
        <Label Content="Kérem a forduló eredményeit [1, 2, X]:" />
        <TextBox x:Name="tbResults" Text="12X12X12X12X12" Margin="0,5,0,5" TextChanged="tbResults_TextChanged" />
        
        <CheckBox x:Name="cbLength" Content="Nem megfelelő a karakterek száma (14)" Margin="0,5,0,5" IsEnabled="False" />
        <CheckBox x:Name="cbChars" Content="Helytelen karakter az eredményekben ()" Margin="0,5,0,5" IsEnabled="False" />
        
        <Button x:Name="btnSave" Content="Eredmények mentése" Margin="0,10,0,0" Width="150" HorizontalAlignment="Left" />
    </StackPanel>
</Window>
