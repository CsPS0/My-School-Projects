<Window x:Class="solticsongor_Towers_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Towers" Height="450" Width="700">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,20,20,0">
            <Label Content="Méret:" FontWeight="Bold"/>
            <ComboBox x:Name="cbSize" SelectedIndex="0" Margin="0,0,0,40" Height="25" VerticalContentAlignment="Center">
                <sys:Int32>3</sys:Int32>
                <sys:Int32>4</sys:Int32>
                <sys:Int32>5</sys:Int32>
                <sys:Int32>6</sys:Int32>
            </ComboBox>

            <Button x:Name="btnPrepare" Content="Előkészítés" Click="BtnPrepare_Click" Margin="0,0,0,20" Height="30"/>
            <Button x:Name="btnCheck" Content="Ellenőrzés" Click="BtnCheck_Click" Margin="0,0,0,20" Height="30" IsEnabled="False"/>
            <Button x:Name="btnCalc" Content="Kiszámolás" Click="BtnCalc_Click" Margin="0,0,0,20" Height="30" IsEnabled="False"/>
        </StackPanel>

        <Viewbox Grid.Column="1" Stretch="Uniform" Margin="10">
            <Grid x:Name="GameGrid" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Viewbox>
    </Grid>
</Window>
