<Window x:Class="solticsongor_WPF_Basics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:solticsongor_WPF_Basics"
        mc:Ignorable="d"
        Title="Random Drawer.exe" Height="1080" Width="1920">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button x:Name="PencilDownBtn" Content="Pencil Down" Click="PencilDown_Click" Margin="5"/>
            <Button x:Name="PencilUpBtn" Content="Pencil Up" Click="PencilUp_Click" Margin="5"/>
        </StackPanel>
        <Canvas x:Name="DrawCanvas" Grid.Row="1" Background="Black" MouseDown="DrawCanvas_MouseDown" 
                MouseMove="DrawCanvas_MouseMove" MouseUp="DrawCanvas_MouseUp"/>
    </Grid>
</Window>