<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Szoftverleltár Kereső" Height="450" Width="600" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Kérem válasszon egy kategóriát:" Margin="0,0,0,5" FontSize="14" />
        <ComboBox Grid.Row="1" x:Name="CmbKategoria" SelectionChanged="CmbKategoria_SelectionChanged" Margin="0,0,0,15" Padding="5" FontSize="14" />

        <TextBlock Grid.Row="2" Text="Kérem válasszon egy szoftvert:" Margin="0,0,0,5" FontSize="14" />
        <ComboBox Grid.Row="3" x:Name="CmbSzoftver" SelectionChanged="CmbSzoftver_SelectionChanged" Margin="0,0,0,15" Padding="5" FontSize="14" IsEnabled="False" />

        <DataGrid Grid.Row="4" x:Name="DgEredmenyek" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" AlternatingRowBackground="#f0f0f0" GridLinesVisibility="None" BorderBrush="#ccc" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="IP Cím" Binding="{Binding IpAddress}" Width="150" />
                <DataGridTextColumn Header="Hely" Binding="{Binding Location}" Width="100" />
                <DataGridTextColumn Header="Verzió" Binding="{Binding Version}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
