<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tamagotchi_NonchalanTeam.ViewModels"
             x:Class="Tamagotchi_NonchalanTeam.Views.GamesMenuView"
             x:DataType="vm:GamesMenuViewModel">
    <Grid Background="#8ecae6">
        <Border Background="#023047" CornerRadius="25" Padding="40" Margin="50" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 15 40 0 #40000000">
            <StackPanel Spacing="30" Width="400">
                <TextBlock Text="GAMES" FontSize="48" FontWeight="Black" Foreground="#ffb703" HorizontalAlignment="Center"/>
                
                <TextBlock Text="{Binding StatusMessage}" FontSize="18" Foreground="#8ecae6" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                
                <Separator Background="#219ebc" Height="2" Margin="0,10"/>

                <Button Content="SNAKE" Command="{Binding StartSnakeCommand}"
                        Background="#fb8500" Foreground="White" Height="80"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        FontSize="24" FontWeight="Black" CornerRadius="15"/>

                <Button Content="TIC TAC TOE" Command="{Binding StartTicTacToeCommand}"
                        Background="#ffb703" Foreground="#023047" Height="80"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        FontSize="24" FontWeight="Black" CornerRadius="15"/>

                <Button Content="Back" Command="{Binding BackCommand}"
                        Background="Transparent" Foreground="#8ecae6" 
                        HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
