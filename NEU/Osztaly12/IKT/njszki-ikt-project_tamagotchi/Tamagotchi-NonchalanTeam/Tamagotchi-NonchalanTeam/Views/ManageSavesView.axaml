<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Tamagotchi_NonchalanTeam.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="Tamagotchi_NonchalanTeam.Views.ManageSavesView"
             x:DataType="vm:ManageSavesViewModel">
    <Grid Background="#8ecae6">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="30" Width="500">
            <TextBlock Text="MANAGE SAVES" FontSize="36" FontWeight="Bold" Foreground="#023047" HorizontalAlignment="Center"/>
            
            <Border Background="White" CornerRadius="15" Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="Save Files Found:" Foreground="#023047" FontWeight="SemiBold"/>
                    
                    <ScrollViewer Height="300">
                        <ItemsControl ItemsSource="{Binding SaveFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="10">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#023047"/>
                                            <Button Grid.Column="1" Content="Delete" 
                                                    Command="{Binding $parent[ItemsControl].((vm:ManageSavesViewModel)DataContext).DeleteSaveCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="#e63946" Foreground="White" Padding="8,4" CornerRadius="5"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Content="DELETE ALL SAVES" Command="{Binding DeleteAllSavesCommand}"
                            Background="#e63946" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="12" CornerRadius="8" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            
            <Button Content="Back" Command="{Binding BackCommand}"
                    Background="#219ebc" Foreground="White" Width="100"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                    Padding="10" CornerRadius="8"/>
        </StackPanel>
    </Grid>
</UserControl>
