# App Configuration
NODE_ENV=development

# Database Configuration (SQLite by default)
# This will create a local SQLite database file named dev.db
DATABASE_URL="file:./dev.db"


# ==========================================
# REQUIRED API KEYS FOR GLOBAL DASHBOARD
# ==========================================

# YouTube Data API v3 Key
# Required for fetching global YouTube channel stats and subscribers.
# Get it here: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# Last.fm API Key
# Required for fetching global Top 10 Music tracks and artist details.
# Get it here: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here


# ==========================================
# NOTE: PERSONAL API KEYS
# ==========================================
# Personal API keys (like Steam API keys for personal game stats) 
# do NOT go in this file. They are entered securely by each user 
# inside the dashboard's "Settings" page and stored in the database.
# 
# Other APIs (CoinGecko, Exophase, Global Steam Charts) do not 
# require an API key to function.