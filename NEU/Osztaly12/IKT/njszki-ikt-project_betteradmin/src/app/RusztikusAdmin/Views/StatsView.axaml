<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RusztikusAdmin.ViewModels"
             x:Class="RusztikusAdmin.Views.StatsView"
             x:DataType="vm:StatsViewModel">

  <ScrollViewer>
      <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" Margin="16">
          
          <!-- Today Bookings -->
          <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="24" Margin="8" BoxShadow="0 1 3 0 #20000000">
              <StackPanel>
                  <TextBlock Text="📅" FontSize="36" HorizontalAlignment="Center"/>
                  <TextBlock Text="Mai foglalások" Foreground="#666" HorizontalAlignment="Center" Margin="0,8"/>
                  <TextBlock Text="{Binding TodayBookingsCount}" FontSize="32" FontWeight="Bold" Foreground="#030213" HorizontalAlignment="Center"/>
              </StackPanel>
          </Border>

          <!-- Today Guests -->
          <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="24" Margin="8" BoxShadow="0 1 3 0 #20000000">
              <StackPanel>
                  <TextBlock Text="👥" FontSize="36" HorizontalAlignment="Center"/>
                  <TextBlock Text="Összes vendég (ma)" Foreground="#666" HorizontalAlignment="Center" Margin="0,8"/>
                  <TextBlock Text="{Binding TodayGuestsCount}" FontSize="32" FontWeight="Bold" Foreground="#030213" HorizontalAlignment="Center"/>
              </StackPanel>
          </Border>

          <!-- Menu Items -->
          <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="24" Margin="8" BoxShadow="0 1 3 0 #20000000">
              <StackPanel>
                  <TextBlock Text="🍽️" FontSize="36" HorizontalAlignment="Center"/>
                  <TextBlock Text="Menüelemek száma" Foreground="#666" HorizontalAlignment="Center" Margin="0,8"/>
                  <TextBlock Text="{Binding MenuItemsCount}" FontSize="32" FontWeight="Bold" Foreground="#030213" HorizontalAlignment="Center"/>
              </StackPanel>
          </Border>

          <!-- Available Tables -->
          <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="24" Margin="8" BoxShadow="0 1 3 0 #20000000">
              <StackPanel>
                  <TextBlock Text="🪑" FontSize="36" HorizontalAlignment="Center"/>
                  <TextBlock Text="Elérhető asztalok" Foreground="#666" HorizontalAlignment="Center" Margin="0,8"/>
                  <TextBlock Text="{Binding AvailableTablesCount}" FontSize="32" FontWeight="Bold" Foreground="#030213" HorizontalAlignment="Center"/>
              </StackPanel>
          </Border>
      </Grid>
  </ScrollViewer>
</UserControl>