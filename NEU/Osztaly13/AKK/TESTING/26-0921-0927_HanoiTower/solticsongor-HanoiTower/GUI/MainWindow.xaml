<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hanoi tornyai" Height="520" Width="900" MinHeight="360" MinWidth="560"
        Background="#1E1E24" Foreground="#EEEEEE" FontSize="15">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Korongok:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="DiskBox" Text="3" Width="44" Padding="4,2" VerticalContentAlignment="Center"/>
            <TextBlock Text="Rudak:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <TextBox x:Name="PegBox" Text="3" Width="44" Padding="4,2" VerticalContentAlignment="Center"/>
            <Button Content="Új játék" Click="NewGame_Click" Margin="16,0,0,0" Padding="14,4" IsDefault="True"/>
            <TextBlock x:Name="MovesText" VerticalAlignment="Center" Margin="24,0,0,0"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,12,0,0" TextWrapping="Wrap"/>

        <UniformGrid x:Name="PegsGrid" Rows="1"/>
    </DockPanel>
</Window>
