<Window x:Class="TanacsadoGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TanacsadoGUI"
        mc:Ignorable="d"
        Title="Tanácsadók adatai" Height="360" Width="480" MinHeight="320" MinWidth="400">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Kérem, válasszon szakterületet!" Padding="0,0,0,5"/>
        <ComboBox Grid.Row="1" x:Name="cbSzakterulet" DisplayMemberPath="Megnevezes" SelectionChanged="cbSzakterulet_SelectionChanged"/>

        <Label Grid.Row="3" Content="Kérem, válasszon tanácsadót!" Padding="0,0,0,5"/>
        <ComboBox Grid.Row="4" x:Name="cbTanacsado" DisplayMemberPath="Nev" SelectionChanged="cbTanacsado_SelectionChanged"/>

        <GroupBox Grid.Row="6" Header="A tanácsadó adatai" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Telefon:" VerticalAlignment="Center" Margin="0,2,10,2"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbTelefon" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2,0,2" Padding="3"/>

                <Label Grid.Row="1" Grid.Column="0" Content="E-mail:" VerticalAlignment="Center" Margin="0,2,10,2"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="tbEmail" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2,0,2" Padding="3"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Óradíj:" VerticalAlignment="Center" Margin="0,2,10,2"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="tbOradij" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2,0,2" Padding="3"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
