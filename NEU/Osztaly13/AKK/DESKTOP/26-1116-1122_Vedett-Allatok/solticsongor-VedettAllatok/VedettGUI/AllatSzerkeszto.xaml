<Window x:Class="VedettGUI.AllatSzerkeszto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VedettGUI"
        Title="Állat" Height="230" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.DataContext>
        <local:AllatSzerkesztoViewModel />
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Column="0" Grid.Row="0" Content="ID" Visibility="{Binding IDVisible}" />
        <TextBox Grid.Column="1" Grid.Row="0" Margin="0,3" IsReadOnly="True" Text="{Binding ID, Mode=OneWay}" Visibility="{Binding IDVisible}" />
        <Label Grid.Column="0" Grid.Row="1" Content="Név" />
        <TextBox Grid.Column="1" Grid.Row="1" Margin="0,3" Text="{Binding Nev}" />
        <Label Grid.Column="0" Grid.Row="2" Content="Érték (Ft)" />
        <TextBox Grid.Column="1" Grid.Row="2" Margin="0,3" Text="{Binding Ertek}" />
        <Label Grid.Column="0" Grid.Row="3" Content="Év" />
        <TextBox Grid.Column="1" Grid.Row="3" Margin="0,3" Text="{Binding Ev}" />
        <Label Grid.Column="0" Grid.Row="4" Content="Kategória" />
        <TextBox Grid.Column="1" Grid.Row="4" Margin="0,3" Text="{Binding Kategoria}" />

        <Button Grid.Column="2" Grid.Row="0" Grid.RowSpan="5" Margin="10,3,0,3" Padding="10,0" Content="Mentés" Click="Button_Click" />
    </Grid>
</Window>
