<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REST API Szörnyvadász - Solti Csongor Péter" Height="600" Width="800"
        Background="White"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="White">
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ScoreLabel" Text="Pont: 0" FontWeight="Bold" FontSize="15" Margin="0,0,15,0"/>
                    <TextBlock x:Name="LivesLabel" Text="Élet: 3" FontWeight="Bold" FontSize="15" Foreground="Red" Margin="0,0,25,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Célpont (REST API): " FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="TargetInfoLabel" Text="Betöltés..." FontSize="13" Foreground="#0066CC" FontWeight="SemiBold"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Új játék" Click="NewGame_Click" Padding="12,4"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ApiCountLabel" Text="1. Érték: 334 szörny az API-ban" Margin="0,0,20,0" FontSize="12" Foreground="#333333" VerticalAlignment="Center"/>
                    <TextBlock Text="3. Lista: " FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MonsterComboBox" Width="180" DisplayMemberPath="name" SelectionChanged="MonsterComboBox_SelectionChanged" Margin="0,0,15,0"/>
                    <Button Content="Következő szörny" Click="NextMonster_Click" Padding="8,2"/>
                </StackPanel>
                <TextBlock Text="API: https://www.dnd5eapi.co/api/2014/monsters" HorizontalAlignment="Right" FontSize="11" Foreground="#777777" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Canvas x:Name="GameCanvas" Background="White" MouseMove="GameCanvas_MouseMove">
            <StackPanel x:Name="MonsterContainer" Canvas.Left="250" Canvas.Top="120" Cursor="Hand" MouseDown="Monster_MouseDown">
                <TextBlock x:Name="MonsterTag" Text="Szörny" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="#B22222" Margin="0,0,0,2"/>
                <Image x:Name="MonsterImage" Width="100" Height="140" Stretch="Uniform"/>
            </StackPanel>

            <Image x:Name="WeaponImage" Width="140" Height="140" Stretch="Uniform" IsHitTestVisible="False" Canvas.Left="300" Canvas.Top="350"/>
        </Canvas>
    </DockPanel>
</Window>
