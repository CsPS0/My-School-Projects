<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Szépségszalon - Alkalmazottak adatai" Height="400" Width="500">
    <StackPanel Margin="20">
        <Label Content="Kérem, válasszon szakmát!"/>
        <ComboBox x:Name="cbSzakmak" SelectionChanged="CbSzakmak_SelectionChanged" Margin="0,0,0,10"/>

        <Label Content="Kérem, válasszon alkalmazottat!"/>
        <ComboBox x:Name="cbAlkalmazottak" SelectionChanged="CbAlkalmazottak_SelectionChanged" Margin="0,0,0,10"/>

        <Label Content="Az alkalmazott telefonszáma"/>
        <TextBox x:Name="tbTelefon" IsReadOnly="True" Height="100"/>
    </StackPanel>
</Window>
