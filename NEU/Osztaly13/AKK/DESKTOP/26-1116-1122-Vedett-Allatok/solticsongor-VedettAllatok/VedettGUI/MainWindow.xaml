<Window x:Class="VedettGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fokozottan védett állatok - Solti Csongor Péter" Height="520" Width="1000"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Állatok kategóriánként" Margin="5" Padding="5">
            <StackPanel>
                <TextBlock Text="Kategória:"/>
                <ListBox x:Name="CategoryListBox" Height="110" SelectionChanged="CategoryListBox_SelectionChanged"/>
                <TextBlock Text="Állatok:" Margin="0,8,0,0"/>
                <ListBox x:Name="AnimalListBox" Height="150" SelectionChanged="AnimalListBox_SelectionChanged"/>
                <TextBlock x:Name="DetailsText" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="Módosítás ID alapján" Margin="5" Padding="5">
            <StackPanel>
                <TextBlock Text="ID:"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="IdTextBox" Width="100"/>
                    <Button Content="Betöltés" Margin="5,0,0,0" Padding="8,2" Click="LoadButton_Click"/>
                </StackPanel>
                <TextBlock Text="Név:" Margin="0,8,0,0"/>
                <TextBox x:Name="EditNameTextBox"/>
                <TextBlock Text="Érték (Ft):" Margin="0,5,0,0"/>
                <TextBox x:Name="EditValueTextBox"/>
                <TextBlock Text="Év:" Margin="0,5,0,0"/>
                <TextBox x:Name="EditYearTextBox"/>
                <TextBlock Text="Kategória:" Margin="0,5,0,0"/>
                <TextBox x:Name="EditCategoryTextBox"/>
                <Button Content="Mentés" Margin="0,10,0,0" Padding="8,2" Click="SaveButton_Click"/>
                <TextBlock x:Name="EditMessage" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="2" Header="Új állat felvitele" Margin="5" Padding="5">
            <StackPanel>
                <TextBlock Text="Név:"/>
                <TextBox x:Name="NewNameTextBox"/>
                <TextBlock Text="Érték (Ft):" Margin="0,5,0,0"/>
                <TextBox x:Name="NewValueTextBox"/>
                <TextBlock Text="Év:" Margin="0,5,0,0"/>
                <TextBox x:Name="NewYearTextBox"/>
                <TextBlock Text="Kategória:" Margin="0,5,0,0"/>
                <TextBox x:Name="NewCategoryTextBox"/>
                <Button Content="Felvitel" Margin="0,10,0,0" Padding="8,2" Click="AddButton_Click"/>
                <TextBlock x:Name="AddMessage" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
