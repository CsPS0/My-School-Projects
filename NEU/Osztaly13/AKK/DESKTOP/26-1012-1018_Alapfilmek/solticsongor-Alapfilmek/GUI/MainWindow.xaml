<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alapfilmek alkotói" Height="380" Width="450"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="Kérem, válasszon alkotót!" Margin="0,0,0,5" />
        <ComboBox x:Name="cbAlkotok" DisplayMemberPath="Nev" SelectionChanged="cbAlkotok_SelectionChanged" Margin="0,0,0,15" />

        <TextBlock Text="Kérem, válasszon filmet!" Margin="0,0,0,5" />
        <ComboBox x:Name="cbFilmek" DisplayMemberPath="Cim" SelectionChanged="cbFilmek_SelectionChanged" Margin="0,0,0,20" />

        <GroupBox Header="A film adatai" Padding="10" MinHeight="160">
            <TextBlock x:Name="tbAdatok" />
        </GroupBox>
    </StackPanel>
</Window>
