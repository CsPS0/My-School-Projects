<Window x:Class="LovaglasGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LovaglasGUI"
        mc:Ignorable="d"
        Title="Lovasoktatás" Height="360" Width="420" MinHeight="320" MinWidth="360">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Kérem válasszon képzést!" x:Name="kepzesIdentifier" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="1" x:Name="kepzesList" Margin="0,2,0,10" SelectionChanged="KepzesList_SelectionChanged"/>

        <Label Grid.Row="2" Content="Kérem válasszon oktatót!" x:Name="oktatoIdentifier" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="3" x:Name="oktatoList" Margin="0,2,0,10" IsEnabled="False" SelectionChanged="OktatoList_SelectionChanged"/>

        <Label Grid.Row="4" Content="Az oktató adatai:" x:Name="adatokBoxTitle" FontWeight="SemiBold"/>
        <ListBox Grid.Row="5" x:Name="adatokBox" Margin="0,2,0,0"/>
    </Grid>
</Window>
